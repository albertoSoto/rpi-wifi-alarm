# Copy to /etc/wifi-alarm/wifi-alarm.env on the Pi and fill in.

WIFI_ALARM_PROFILE=pi

# Detector
REPLY_TIMEOUT_S=60
DETECTOR_WINDOW=100
DETECTOR_CAL_FRAMES=1000
DETECTOR_THRESHOLD_MULT=4.0

# Nexmon CSI
NEXMON_UDP_PORT=5500
NEXMON_N_SUBCARRIERS=256   # 80 MHz capture; use 64 for 20 MHz

# Siren GPIO
SIREN_GPIO_PIN=17
SIREN_ACTIVE_HIGH=false    # set to true if your relay is high-trigger

# Storage
SQLITE_PATH=/var/lib/wifi-alarm/state.db

# Telegram (required for two-way control)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (optional, outbound only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
